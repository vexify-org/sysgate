{"version": 2, "width": 100, "height": 30, "timestamp": 1793249451, "idle_time_limit": 1.0, "env": {"SHELL": "/bin/bash", "TERM": null}}
[0.00366, "o", "\u001b[2J\u001b[H\r\n\u001b[1;36m== sysgate: warm gVisor sandboxes behind a tiny HTTP API\u001b[0m\r\n\r\n\u001b[1;32m$\u001b[0m uname -sr\r\n"]
[0.005252, "o", "Linux 6.18.54-instabox\r\n"]
[1.206689, "o", "\r\n\u001b[1;36m== 1. Start the gateway with 2 pre-booted sandboxes\u001b[0m\r\n"]
[7.230751, "o", "\r\n\u001b[1;32m$\u001b[0m sudo -n env SYSGATE_DRIVER=runsc SYSGATE_ROOTFS=/data/gvisor-rootfs SYSGATE_ROOT=/data/sysgate/.runsc SYSGATE_LISTEN=127.0.0.1:18082 SYSGATE_POOL_SIZE=2 setsid ./target/release/sysgate >/tmp/sysgate-demo.log 2>&1 < /dev/null &\r\n"]
[8.440661, "o", "\r\n\u001b[1;32m$\u001b[0m curl -s http://127.0.0.1:18082/healthz; echo\r\n"]
[8.445521, "o", "{\"driver\":\"runsc\",\"status\":\"ok\"}"]
[8.446154, "o", "\r\n"]
[9.647605, "o", "\r\n\u001b[1;32m$\u001b[0m curl -s http://127.0.0.1:18082/metrics | grep '^sysgate_pool_warm '\r\n"]
[9.654311, "o", "sysgate_pool_warm 2\r\n"]
[10.856569, "o", "\r\n\u001b[1;36m== 2. Create a sandbox: served instantly from the warm pool\u001b[0m\r\n\r\n\u001b[1;32m$\u001b[0m curl -s -X POST http://127.0.0.1:18082/v1/sandboxes | tee /tmp/sysgate-create.json | jq .\r\n"]
[10.864635, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"sg-4fb7c4c9341f408987de7de4d6505645\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"driver\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"runsc\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"created_at\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"2026-10-29T04:51:01.892077347Z\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"expires_at\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"2026-10-29T05:01:01.892077347Z\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[12.068956, "o", "\r\n\u001b[1;36m== 3. Execute inside the sandbox\u001b[0m\r\n\r\n\u001b[1;32m$\u001b[0m curl -s -X POST http://127.0.0.1:18082/v1/sandboxes/$ID/exec -H 'content-type: application/json' -d '{\"argv\":[\"/bin/echo\",\"hello from gVisor\"]}' | jq -c .\r\n"]
[12.082894, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"duration_ms\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m6\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"exit_code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stderr\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stdout\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"hello from gVisor\\n\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[13.284491, "o", "\r\n\u001b[1;32m$\u001b[0m curl -s -X POST http://127.0.0.1:18082/v1/sandboxes/$ID/exec -H 'content-type: application/json' -d '{\"argv\":[\"/bin/sh\",\"-c\",\"uname -sr\"]}' | jq -c .\r\n"]
[13.30449, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"duration_ms\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m11\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"exit_code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stderr\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stdout\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Linux 4.19.0-gvisor\\n\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[14.506582, "o", "\r\n\u001b[1;36m== 4. Proof: the workload runs on the gVisor kernel, not the host\u001b[0m\r\n\r\n\u001b[1;32m$\u001b[0m curl -s -X POST http://127.0.0.1:18082/v1/sandboxes/$ID/exec -H 'content-type: application/json' -d '{\"argv\":[\"/bin/cat\",\"/proc/version\"]}' | jq -r .stdout\r\n"]
[14.521671, "o", "Linux version 4.19.0-gvisor #1 SMP Sun Jan 10 15:06:54 PST 2016\r\n\r\n"]
[15.723414, "o", "\r\n\u001b[1;36m== 5. Exit codes pass through\u001b[0m\r\n\r\n\u001b[1;32m$\u001b[0m curl -s -X POST http://127.0.0.1:18082/v1/sandboxes/$ID/exec -H 'content-type: application/json' -d '{\"argv\":[\"/bin/sh\",\"-c\",\"exit 42\"]}' | jq -c .\r\n"]
[15.740834, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"duration_ms\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m8\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"exit_code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m42\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stderr\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stdout\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[16.943042, "o", "\r\n\u001b[1;36m== 6. Metrics\u001b[0m\r\n\r\n\u001b[1;32m$\u001b[0m curl -s http://127.0.0.1:18082/metrics | grep -E '^sysgate_(pool_warm|pool_hits_total|pool_misses_total|sandboxes_created_total|sandboxes_destroyed_total|exec_total) '\r\n"]
[16.950237, "o", "sysgate_sandboxes_created_total 1\r\nsysgate_sandboxes_destroyed_total 0\r\n"]
[16.950259, "o", "sysgate_exec_total 4\r\nsysgate_pool_warm 2\r\n"]
[16.950281, "o", "sysgate_pool_hits_total 1\r\n"]
[16.950284, "o", "sysgate_pool_misses_total 0\r\n"]
[18.152789, "o", "\r\n\u001b[1;36m== 7. Delete: destroy the sandbox, refill the pool\u001b[0m\r\n\r\n\u001b[1;32m$\u001b[0m curl -s -o /dev/null -w 'HTTP %{http_code}\\n' -X DELETE http://127.0.0.1:18082/v1/sandboxes/$ID\r\n"]
[18.166786, "o", "HTTP 204\r\n"]
[22.370423, "o", "\r\n\u001b[1;32m$\u001b[0m sudo -n runsc --root /data/sysgate/.runsc list | awk 'NR==1 {print $1, $3} NR>1 {print $1, $3}'\r\n"]
[22.382185, "o", "ID STATUS\r\nsg-21aa494c3f93426eae3af1ec7728aeaf running\r\nsg-bbce508cc2764649a1b80acc9c0bd5a2 running\r\n"]
[23.5836, "o", "\r\n\u001b[1;36m== 8. Shutdown: every warm sandbox is cleaned up\u001b[0m\r\n\r\n\u001b[1;32m$\u001b[0m sudo -n pkill -x sysgate\r\n"]
[30.80175, "o", "\r\n\u001b[1;32m$\u001b[0m sudo -n runsc --root /data/sysgate/.runsc list\r\n"]
[30.812416, "o", "ID          PID         STATUS      BUNDLE      CREATED     OWNER\r\n"]
[32.015177, "o", "\r\n\u001b[1;32mAll clean: sysgate + gVisor, end to end.\u001b[0m\r\n"]
